# 이 파일을 .env.local(웹) / .env(파이썬 스크립트)로 복사해서 값을 채우세요.
# Supabase 대시보드 > Project Settings > API 에서 확인할 수 있습니다.

# ── 웹 앱 (Next.js) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 브라우저에 노출되면 안 됩니다 (NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# ── 파이프라인 (scripts/*.py) ──
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY 는 위와 같은 값
# https://mathpix.com 에서 발급
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
