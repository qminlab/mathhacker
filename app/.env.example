# app/.env.local 로 복사해서 채우세요. (EXPO_PUBLIC_ 값은 앱 안에 그대로 들어가니 비밀값을 넣지 마세요)

# Supabase 대시보드 > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# server/ 를 배포한 주소 (개발 중에는 같은 와이파이의 맥 주소, 예: http://192.168.0.10:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# 1로 두면 서버 없이 예제 데이터로 화면만 둘러보는 체험 모드
EXPO_PUBLIC_DEMO=0
