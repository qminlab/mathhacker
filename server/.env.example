# server/.env.local 로 복사해서 채우세요. (Vercel에 배포할 때는 프로젝트 Environment Variables에 같은 이름으로)
# Supabase 대시보드 > Project Settings > API

SUPABASE_URL=https://your-project.supabase.co
# anon(publishable) 키: 요청한 사용자의 토큰을 확인하는 데 씁니다
SUPABASE_ANON_KEY=
# service_role(secret) 키: 서버 전용. 절대 앱이나 GitHub에 넣지 마세요
SUPABASE_SERVICE_ROLE_KEY=

# https://mathpix.com > Console > API Keys
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
